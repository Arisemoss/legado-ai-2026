<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <io.legado.app.ui.widget.prefs.NameListPreference
        android:key="ai_provider"
        android:title="服务商预设"
        android:summary="选择服务商可自动填充 Base URL 与推荐模型"
        android:defaultValue="deepseek"
        app:entries="@array/ai_provider_entries"
        app:entryValues="@array/ai_provider_values"
        app:iconSpaceReserved="false" />

    <io.legado.app.ui.widget.prefs.EditTextPreference
        android:key="ai_base_url"
        android:title="服务商 Base URL"
        android:summary="选服务商自动填充，也可自定"
        android:defaultValue="https://api.openai.com/v1"
        app:iconSpaceReserved="false" />

    <io.legado.app.ui.widget.prefs.EditTextPreference
        android:key="ai_api_key"
        android:title="API Key"
        android:summary="将加密存储于系统密钥库"
        android:inputType="textPassword"
        app:iconSpaceReserved="false" />

    <io.legado.app.ui.widget.prefs.EditTextPreference
        android:key="ai_model"
        android:title="模型名"
        android:defaultValue="gpt-4o-mini"
        app:iconSpaceReserved="false" />

    <io.legado.app.ui.widget.prefs.SwitchPreference
        android:key="ai_stream"
        android:title="流式输出"
        android:summary="开启后分块流式返回，打字机效果"
        android:defaultValue="false"
        app:iconSpaceReserved="false" />

    <ListPreference
        android:key="ai_tool_protocol"
        android:title="工具调用协议"
        android:summary="auto=原生+文本双通道；text 兼容不支持函数调用的服务商"
        android:defaultValue="auto"
        android:entries="@array/ai_tool_protocol_entries"
        android:entryValues="@array/ai_tool_protocol_values"
        app:iconSpaceReserved="false" />

    <io.legado.app.ui.widget.prefs.EditTextPreference
        android:key="ai_timeout"
        android:title="轮询超时(毫秒)"
        android:defaultValue="120000"
        app:iconSpaceReserved="false" />

    <io.legado.app.ui.widget.prefs.EditTextPreference
        android:key="ai_max_rounds"
        android:title="最大工具轮数"
        android:defaultValue="5"
        app:iconSpaceReserved="false" />

    <io.legado.app.ui.widget.prefs.EditTextPreference
        android:key="ai_session_window"
        android:title="会话消息窗口"
        android:defaultValue="50"
        app:iconSpaceReserved="false" />


    <PreferenceCategory android:title="聊天背景（RikkaHub 风格）"
        app:iconSpaceReserved="false">

        <io.legado.app.ui.widget.prefs.Preference
            android:key="ai_chat_bg_pick"
            android:title="选择背景图片"
            android:summary="从相册选择图片作为 AI 对话背景"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="ai_chat_bg_opacity"
            android:title="背景图不透明度"
            android:defaultValue="60"
            android:entries="@array/ai_bg_opacity_entries"
            android:entryValues="@array/ai_bg_opacity_values"
            app:iconSpaceReserved="false" />

        <io.legado.app.ui.widget.prefs.SwitchPreference
            android:key="ai_chat_bg_gradient"
            android:title="极光渐变背景"
            android:summary="Gemini 风动态流光渐变，优先于背景图片"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <io.legado.app.ui.widget.prefs.Preference
            android:key="ai_chat_bg_clear"
            android:title="清除自定义背景"
            android:summary="恢复默认纯色背景"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>