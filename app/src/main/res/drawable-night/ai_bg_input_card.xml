<?xml version="1.0" encoding="utf-8"?>
<!-- 输入栏：毛玻璃渐变（夜间）——深色半透明渐变 + 微光描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#CC1E1F25"
                android:endColor="#99242530" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#3D454750" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
